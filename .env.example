# Local-only secrets for `npm run dev` (copy to .env). On Cloudflare set each with
# `npx wrangler secret put NAME`. Never commit real values or training JSON.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Filled in by `npm run strava:auth`.
STRAVA_REFRESH_TOKEN=
TRAINHEROIC_EMAIL=
TRAINHEROIC_PASSWORD=
# Cloudflare only: Zero Trust team domain (e.g. yourteam.cloudflareaccess.com) and app AUD tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
